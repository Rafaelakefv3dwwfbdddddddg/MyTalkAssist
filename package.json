{
  "name": "mytalkassist",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/stack": "^7.10.23",
    "expo": "~57.0.16",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-file-system": "~57.0.7",
    "expo-speech": "~57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "desktop:export": "expo export --platform web",
    "desktop:dev": "npm run desktop:export && electron electron/main.cjs",
    "desktop:build": "npm run desktop:export && electron-builder --win",
    "desktop:portable": "npm run desktop:export && electron-builder --win portable"
  },
  "private": true,
  "build": {
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "appId": "com.talkassist.desktop",
    "productName": "TalkAssist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "TalkAssist-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "TalkAssist-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TalkAssist"
    }
  }
}
